      "start": 373.279,
      "duration": 2.4,
      "text": "noch ein paar andere Dinge, wie zum"
    },
    {
      "start": 374.719,
      "duration": 2.2,
      "text": "Beispiel die Darstellung einer"
    },
    {
      "start": 375.959,
      "duration": 2.976,
      "text": "Kaffeemaschine. Das Verrückte ist,"
    },
    {
      "start": 377.994,
      "duration": 3.032,
      "text": "dass der Opus 5.5 Checkpoint sogar"
    },
    {
      "start": 380.086,
      "duration": 3.109,
      "text": "besser ist als der Opus 5.2. Ich bin"
    },
    {
      "start": 382.243,
      "duration": 2.824,
      "text": "mir nicht sicher, ob sie diese Version"
    },
    {
      "start": 384.115,
      "duration": 2.728,
      "text": "veröffentlichen werden, aber es ist"
    },
    {
      "start": 385.891,
      "duration": 2.632,
      "text": "verrückt zu sehen, dass Anthropic"
    },
    {
      "start": 387.571,
      "duration": 2.872,
      "text": "diese unentdeckten, stillen Modelle hat"
    },
    {
      "start": 389.443,
      "duration": 2.536,
      "text": ", die sie letztendlich gar nicht"
    },
    {
      "start": 391.027,
      "duration": 4.147,
      "text": "herausbringen. Vielleicht tun sie es"
    },
    {
      "start": 394.23,
      "duration": 3.014,
      "text": "bei der 5.5, aber es zeigt deutlich,"
    },
    {
      "start": 396.3,
      "duration": 3.014,
      "text": "wie viel große Kraft derzeit hinter"
    },
    {
      "start": 398.37,
      "duration": 3.182,
      "text": "diesen Bemühungen zurückgehalten wird"
    },
    {
      "start": 400.552,
      "duration": 5.492,
      "text": ", Leute. Aber schauen wir weiter zu"
    },
    {
      "start": 405.105,
      "duration": 3.407,
      "text": "StepFun, denn sie haben gerade erst die"
    },
    {
      "start": 407.574,
      "duration": 4.559,
      "text": "Step 5 Preview vorgestellt. Das sieht"
    },
    {
      "start": 411.192,
      "duration": 3.31,
      "text": "nach einem ernsthaften Konkurrenten aus"
    },
    {
      "start": 413.502,
      "duration": 3.014,
      "text": ", denn dieses neue Modell, das sie"
    },
    {
      "start": 415.575,
      "duration": 3.015,
      "text": "veröffentlicht haben, ist bei der"
    },
    {
      "start": 417.649,
      "duration": 2.718,
      "text": "Preisgestaltung sowie bei den"
    },
    {
      "start": 419.426,
      "duration": 3.133,
      "text": "Benchmarks extrem wettbewerbsfähig."
    },
    {
      "start": 422.72,
      "duration": 2.798,
      "text": "Step 5 Preview ist ihr nächstes"
    },
    {
      "start": 424.574,
      "duration": 2.855,
      "text": "Flaggschiff-Modell, das stark auf"
    },
    {
      "start": 426.485,
      "duration": 3.136,
      "text": "agentische Arbeit, Softwareentwicklung"
    },
    {
      "start": 428.677,
      "duration": 2.911,
      "text": "und professionelle Wissensaufgaben"
    },
    {
      "start": 430.644,
      "duration": 3.257,
      "text": "ausgerichtet ist. Das ist es, was"
    },
    {
      "start": 432.951,
      "duration": 2.878,
      "text": "StepFun besonders hervorhebt, wenn es"
    },
    {
      "start": 434.88,
      "duration": 2.979,
      "text": "um ihre Stärken im Finanzbereich geht."
    },
    {
      "start": 437.899,
      "duration": 3.564,
      "text": "Aber dieses Modell, das wir uns gerade"
    },
    {
      "start": 440.53,
      "duration": 3.429,
      "text": "ansehen, ist ein riesiges MoE-Modell"
    },
    {
      "start": 443.027,
      "duration": 3.294,
      "text": "mit 600 Milliarden Parametern, von"
    },
    {
      "start": 445.388,
      "duration": 3.025,
      "text": "denen jedoch nur 27 Milliarden"
    },
    {
      "start": 447.48,
      "duration": 4.087,
      "text": "gleichzeitig aktiv sind. Es bietet"
    },
    {
      "start": 450.618,
      "duration": 2.453,
      "text": "zudem Vision-Support und ein"
    },
    {
      "start": 452.123,
      "duration": 4.089,
      "text": "Kontextfenster von 1 Million Token. Was"
    },
    {
      "start": 455.27,
      "duration": 3.146,
      "text": "jedoch wirklich heraussticht, ist das"
    },
    {
      "start": 457.474,
      "duration": 3.203,
      "text": "Preis-Leistungs-Verhältnis, denn laut"
    },
    {
      "start": 459.735,
      "duration": 2.681,
      "text": "den eigenen Daten von StepFun"
    },
    {
      "start": 461.474,
      "duration": 2.972,
      "text": "konkurriert Step 5 Preview auf dem"
    },
    {
      "start": 463.504,
      "duration": 3.029,
      "text": "Niveau von Modellen wie GLM 5.3 und"
    },
    {
      "start": 465.591,
      "duration": 3.203,
      "text": "Qwen 1.5 3, während es potenziell 65%"
    },
    {
      "start": 467.794,
      "duration": 4.17,
      "text": "weniger pro Aufgabe kostet. Sie betonen"
    },
    {
      "start": 471.011,
      "duration": 2.764,
      "text": "außerdem die Ausführung über lange"
    },
    {
      "start": 472.823,
      "duration": 2.62,
      "text": "Zeiträume, was bedeutet, dass das"
    },
    {
      "start": 474.491,
      "duration": 2.859,
      "text": "Modell darauf ausgelegt ist, wesentlich"
    },
    {
      "start": 476.397,
      "duration": 2.097,
      "text": "längere und komplexere"
    },
    {
      "start": 477.541,
      "duration": 2.478,
      "text": "Softwareentwicklungsaufgaben zu"
    },
    {
      "start": 479.067,
      "duration": 3.552,
      "text": "bewältigen. Und während man die"
    },
    {
      "start": 481.675,
      "duration": 3.072,
      "text": "Vorschau bereits über StepFun selbst"
    },
    {
      "start": 483.803,
      "duration": 3.016,
      "text": "testen kann, ist der 15. Oktober das"
    },
    {
      "start": 485.875,
      "duration": 3.184,
      "text": "große Datum, auf das man achten sollte"
    },
    {
      "start": 488.059,
      "duration": 2.96,
      "text": ", da sie an diesem Tag die Gewichte"
    },
    {
      "start": 490.075,
      "duration": 3.625,
      "text": "veröffentlichen wollen. Der einzige"
    },
    {
      "start": 492.764,
      "duration": 3.42,
      "text": "Haken ist die Größe, denn ein Modell"
    },
    {
      "start": 495.248,
      "duration": 3.229,
      "text": "mit 600 Milliarden Parametern lokal"
    },
    {
      "start": 497.541,
      "duration": 2.974,
      "text": "ausführen zu wollen, erfordert"
    },
    {
      "start": 499.579,
      "duration": 3.421,
      "text": "natürlich einige ernsthafte Hardware."
    },
    {
      "start": 503.319,
      "duration": 2.931,
      "text": "Und selbst mit Quantisierung wird es"
    },
    {
      "start": 505.303,
      "duration": 2.985,
      "text": "praktisch unmöglich sein, dies lokal"
    },
    {
      "start": 507.342,
      "duration": 2.77,
      "text": "auszuführen, weil es einfach ein"
    },
    {
      "start": 509.166,
      "duration": 4.227,
      "text": "massives Modell ist. Aber sobald diese"
    },
    {
      "start": 512.435,
      "duration": 2.51,
      "text": "Gewichte verfügbar sind, werden wir"
    },
    {
      "start": 513.987,
      "duration": 2.594,
      "text": "definitiv sehen, was die Community aus"
    },
    {
      "start": 515.623,
      "duration": 3.536,
      "text": "diesem Ding herausholen kann. Ich werde"
    },
    {
      "start": 518.212,
      "duration": 3.08,
      "text": "euch definitiv auf dem Laufenden halten"
    },
    {
      "start": 520.292,
      "duration": 2.867,
      "text": ", was sie am Ende mit diesem Modell"
    },
    {
      "start": 522.212,
      "duration": 2.493,
      "text": "veröffentlichen und was ihr"
    },
    {
      "start": 523.759,
      "duration": 2.813,
      "text": "tatsächlich lokal damit anstellen"
    },
    {
      "start": 525.625,
      "duration": 4.324,
      "text": "könnt. Als nächstes sieht es so aus,"
    },
    {
      "start": 528.996,
      "duration": 2.504,
      "text": "als ob die Veröffentlichung von"
    },
    {
      "start": 530.547,
      "duration": 2.833,
      "text": "MiniMax M 3.1 kurz bevorstehen könnte."
    },
    {
      "start": 533.279,
      "duration": 3.646,
      "text": "Hinweise auf MiniMax M 3.1 sind nun in"
    },
    {
      "start": 535.995,
      "duration": 3.368,
      "text": "Testdateien eines geheimen Commits"
    },
    {
      "start": 538.433,
      "duration": 2.324,
      "text": "aufgetaucht, der im"
    },
    {
      "start": 539.826,
      "duration": 3.717,
      "text": "MiniMax-Code-Repository gefunden wurde,"
    },
    {
      "start": 542.613,
      "duration": 2.671,
      "text": "welches ebenfalls gerade"
    },
    {
      "start": 544.354,
      "duration": 3.577,
      "text": "veröffentlicht wurde und Open Source"
    },
    {
      "start": 547.001,
      "duration": 4.283,
      "text": "ist. Natürlich bestätigt dies noch"
    },
    {
      "start": 550.336,
      "duration": 2.707,
      "text": "kein Veröffentlichungsdatum oder"
    },
    {
      "start": 552.095,
      "duration": 2.811,
      "text": "ähnliches, aber es ist ein starker"
    },
    {
      "start": 553.958,
      "duration": 2.915,
      "text": "Hinweis darauf, dass MiniMax an ihrem"
    },
    {
      "start": 555.925,
      "duration": 2.915,
      "text": "nächsten Modell arbeitet, dem M 3.1."
    },
    {
      "start": 559.022,
      "duration": 3.906,
      "text": "Nach dem, was ich gehört habe, scheint"
    },
    {
      "start": 562.002,
      "duration": 4.427,
      "text": "es derzeit vorbereitet zu werden. Wir"
    },
    {
      "start": 565.498,
      "duration": 3.579,
      "text": "sind also sehr nah dran, dass sie die"
    },
    {
      "start": 568.146,
      "duration": 3.021,
      "text": "letzten Handgriffe für diese"
    },
    {
      "start": 570.237,
      "duration": 3.23,
      "text": "Veröffentlichung vornehmen, und"
    },
    {
      "start": 572.536,
      "duration": 3.509,
      "text": "vielleicht sehen wir das Modell noch"
    },
    {
      "start": 575.115,
      "duration": 3.09,
      "text": "Ende diesen Monats oder Anfang"
    },
    {
      "start": 577.275,
      "duration": 4.746,
      "text": "nächsten Monats. Während der"
    },
    {
      "start": 581.087,
      "duration": 3.479,
      "text": "Zwischenergebnis-Konferenz von MiniMax"
    },
    {
      "start": 583.631,
      "duration": 3.413,
      "text": "am 26. August erklärte der CEO, dass"
    },
    {
      "start": 586.11,
      "duration": 3.218,
      "text": "mehrere kommende Modelle, darunter"
    },
    {
      "start": 588.393,
      "duration": 3.414,
      "text": "MiniMax M 3.1, M3 Pro und H 3.1, kurz"
    },
    {
      "start": 590.872,
      "duration": 5.16,
      "text": "vor der Fertigstellung stünden. Dieses"
    },
    {
      "start": 595.084,
      "duration": 2.925,
      "text": "M 3.1-Modell scheint sich weniger auf"
    },
    {
      "start": 597.061,
      "duration": 2.978,
      "text": "die reine Skalierung zu konzentrieren,"
    },
    {
      "start": 599.091,
      "duration": 2.769,
      "text": "sondern mehr darauf, es für reale"
    },
    {
      "start": 600.913,
      "duration": 3.029,
      "text": "Anwendungsfälle extrem zuverlässig zu"
    },
    {
      "start": 602.994,
      "duration": 3.801,
      "text": "machen. MiniMax gibt an, dass sie"
    },
    {
      "start": 605.849,
      "duration": 2.626,
      "text": "Stabilität, Ausgabequalität,"
    },
    {
      "start": 607.529,
      "duration": 2.518,
      "text": "Inferenz-Effizienz sowie die"
    },
    {
      "start": 609.101,
      "duration": 2.734,
      "text": "Verallgemeinerungsfähigkeit von"
    },
    {
      "start": 610.89,
      "duration": 3.315,
      "text": "Agenten optimieren. Im Grunde versuchen"
    },
    {
      "start": 613.245,
      "duration": 2.371,
      "text": "sie, ein Modell zu bauen, das ihre"
    },
    {
      "start": 614.656,
      "duration": 2.532,
      "text": "breitere Infrastruktur zuverlässig im"
    },
    {
      "start": 616.228,
      "duration": 3.887,
      "text": "großen Maßstab betreiben kann. Aber"
    },
    {
      "start": 619.174,
      "duration": 3.186,
      "text": "bei M3 Pro wird es richtig verrückt,"
    },
    {
      "start": 621.42,
      "duration": 3.186,
      "text": "denn MiniMax sagt, dass dieses Modell"
    },
    {
      "start": 623.665,
      "duration": 3.246,
      "text": "fast 3 Billionen Parameter umfasst und"
    },
    {
      "start": 625.97,
      "duration": 2.832,
      "text": "ein großes Architektur-Upgrade"
    },
    {
      "start": 627.861,
      "duration": 2.536,
      "text": "enthält, das Bereiche wie"
    },
    {
      "start": 629.456,
      "duration": 2.419,
      "text": "Pre-Training-Skalierung,"
    },
    {
      "start": 630.934,
      "duration": 3.068,
      "text": "Trainingseffizienz und Aufgaben mit"
    },
    {
      "start": 633.061,
      "duration": 2.655,
      "text": "extrem langen Zeithorizonten"
    },
    {
      "start": 634.775,
      "duration": 3.948,
      "text": "voranbringen wird. Wenn dir dieses"
    },
    {
      "start": 637.772,
      "duration": 2.496,
      "text": "Video gefällt und du den Kanal"
    },
    {
      "start": 639.316,
      "duration": 2.882,
      "text": "unterstützen möchtest, kannst du eine"
    },
    {
      "start": 641.246,
      "duration": 2.738,
      "text": "Spende über die Super Thanks-Option"
    },
    {
      "start": 643.032,
      "duration": 3.391,
      "text": "unten in Betracht ziehen. Oder du"
    },
    {
      "start": 645.469,
      "duration": 2.435,
      "text": "kannst unserem privaten Discord"
    },
    {
      "start": 646.95,
      "duration": 2.759,
      "text": "beitreten, wo du monatlich kostenlosen"
    },
    {
      "start": 648.756,
      "duration": 2.666,
      "text": "Zugriff auf verschiedene Abonnements"
    },
    {
      "start": 650.468,
      "duration": 3.893,
      "text": "für KI-Tools erhältst. Dazu gibt es"
    },
    {
      "start": 653.416,
      "duration": 2.986,
      "text": "tägliche KI-News, exklusive Inhalte"
    },
    {
      "start": 655.457,
      "duration": 4.423,
      "text": "und vieles mehr. Und das ist nicht die"
    },
    {
      "start": 658.942,
      "duration": 3.416,
      "text": "einzige KI aus China, an der gearbeitet"
    },
    {
      "start": 661.42,
      "duration": 3.354,
      "text": "wird, denn Alibaba arbeitet an Qwen-4,"
    },
    {
      "start": 663.836,
      "duration": 3.291,
      "text": "und es könnte schon bald erscheinen,"
    },
    {
      "start": 666.189,
      "duration": 3.168,
      "text": "vielleicht schon nächste Woche, da"
    },
    {
      "start": 668.419,
      "duration": 3.106,
      "text": "Alibabas kommende Aspara-Konferenz"
    },
    {
      "start": 670.587,
      "duration": 4.957,
      "text": "nächste Woche stattfindet. Dahinter"
    },
    {
      "start": 674.605,
      "duration": 2.939,
      "text": "steckt tatsächlich eine gewisse"
    },
    {
      "start": 676.605,
      "duration": 3.242,
      "text": "Geschichte, denn Alibaba hat frühere"
    },
    {
      "start": 678.908,
      "duration": 3.364,
      "text": "Aspara-Konferenzen genutzt, um wichtige"
    },
    {
      "start": 681.332,
      "duration": 2.879,
      "text": "Qwen-Generationen vorzustellen,"
    },
    {
      "start": 683.272,
      "duration": 2.879,
      "text": "darunter ihr 2.0-Modell aus der"
    },
    {
      "start": 685.211,
      "duration": 3.243,
      "text": "Tongyi-Modellserie sowie Qwen 2.5 und"
    },
    {
      "start": 687.514,
      "duration": 3.486,
      "text": "Qwen 3. Es besteht also eine reale"
    },
    {
      "start": 690.047,
      "duration": 2.662,
      "text": "Möglichkeit, dass wir dort auch die"
    },
    {
      "start": 691.755,
      "duration": 3.996,
      "text": "nächste Generation sehen werden. Die"
    },
    {
      "start": 694.808,
      "duration": 3.055,
      "text": "Konferenzagenda macht das Ganze noch"
    },
    {
      "start": 696.92,
      "duration": 2.998,
      "text": "interessanter, da es eine komplette"
    },
    {
      "start": 698.976,
      "duration": 2.826,
      "text": "Session namens „Advancing Qwen"
    },
    {
      "start": 700.86,
      "duration": 2.941,
      "text": "towards agentic AI“ gibt, in der"
    },
    {
      "start": 702.858,
      "duration": 3.169,
      "text": "Alibaba das neueste Flaggschiff-Modell"
    },
    {
      "start": 705.084,
      "duration": 3.17,
      "text": "mit großen Verbesserungen bei Coding-"
    },
    {
      "start": 707.254,
      "duration": 3.112,
      "text": "und Büro-Funktionen vorstellen will,"
    },
    {
      "start": 709.423,
      "duration": 3.227,
      "text": "neben einem neuen Omni-Modell und einem"
    },
    {
      "start": 711.707,
      "duration": 2.884,
      "text": "Echtzeit-Übersetzungsmodell für"
    },
    {
      "start": 713.648,
      "duration": 4.454,
      "text": "mehrere Sprachen. Interessant ist"
    },
    {
      "start": 717.17,
      "duration": 3.592,
      "text": "jedoch, dass für die Aspera-Konferenz"
    },
    {
      "start": 719.83,
      "duration": 2.978,
      "text": "noch weitere kommende Modelle"
    },
    {
      "start": 721.876,
      "duration": 3.524,
      "text": "angekündigt wurden, wie zum Beispiel"
    },
    {
      "start": 724.468,
      "duration": 3.456,
      "text": "die Vorschau auf Happy Oyster 2, ihr"
    },
    {
      "start": 726.992,
      "duration": 3.629,
      "text": "World-Modell. Sie veröffentlichen"
    },
    {
      "start": 729.672,
      "duration": 2.452,
      "text": "außerdem einige verschiedene"
    },
    {
      "start": 731.174,
      "duration": 2.553,
      "text": "Audio-Modelle, wie ASR, TTS und"
    },
    {
      "start": 732.778,
      "duration": 3.556,
      "text": "Echtzeit-Funktionen. Und dann haben wir"
    },
    {
      "start": 735.388,
      "duration": 2.593,
      "text": "noch ein neues Bildmodell, das"
    },
    {
      "start": 737.034,
      "duration": 2.54,
      "text": "tatsächlich schon vor dieser"
    },
    {
      "start": 738.627,
      "duration": 3.072,
      "text": "Aspera-Konferenz veröffentlicht wurde."
    },
    {
      "start": 742.04,
      "duration": 4.07,
      "text": "Das ist Qwen Image 2.1. Dies ist ein"
    },
    {
      "start": 745.164,
      "duration": 2.843,
      "text": "neues Open-Weight-Bildmodell mit 7"
    },
    {
      "start": 747.061,
      "duration": 2.627,
      "text": "Milliarden Parametern für die"
    },
    {
      "start": 748.742,
      "duration": 3.392,
      "text": "Generierung und Bearbeitung. Und das"
    },
    {
      "start": 751.199,
      "duration": 3.272,
      "text": "Verrückte daran ist, dass es nur 7"
    },
    {
      "start": 753.536,
      "duration": 4.459,
      "text": "Milliarden Parameter hat. Wir haben"
    },
    {
      "start": 757.051,
      "duration": 3.043,
      "text": "viele verschiedene Rückmeldungen von"
    },
    {
