      "start": 365.497,
      "duration": 3.123,
      "text": "beeindruckend und fügt eine Menge"
    },
    {
      "start": 367.683,
      "duration": 3.31,
      "text": "verschiedener Elemente hinzu, die wir"
    },
    {
      "start": 370.055,
      "duration": 3.247,
      "text": "so bei keinem anderen Modell gesehen"
    },
    {
      "start": 372.365,
      "duration": 3.575,
      "text": "haben. Dieser Checkpoint zeigt uns"
    },
    {
      "start": 374.984,
      "duration": 2.513,
      "text": "wirklich, wie beeindruckend dieser"
    },
    {
      "start": 376.542,
      "duration": 2.646,
      "text": "frühe Blick auf Fable 5.2 ist, da es"
    },
    {
      "start": 378.232,
      "duration": 2.335,
      "text": "in Bezug auf seine agentischen"
    },
    {
      "start": 379.612,
      "duration": 2.423,
      "text": "Programmierfähigkeiten wirklich"
    },
    {
      "start": 381.08,
      "duration": 2.691,
      "text": "leistungsfähig ist, besonders wenn es"
    },
    {
      "start": 382.815,
      "duration": 2.513,
      "text": "darum geht, verschiedene Arten von"
    },
    {
      "start": 384.372,
      "duration": 2.647,
      "text": "Visuals und Spielen zu programmieren."
    },
    {
      "start": 387.88,
      "duration": 2.867,
      "text": "Basierend auf diesem Frontend ist es"
    },
    {
      "start": 389.799,
      "duration": 2.815,
      "text": "natürlich noch etwas zu früh für"
    },
    {
      "start": 391.666,
      "duration": 2.608,
      "text": "diese Behauptung, aber es sieht"
    },
    {
      "start": 393.326,
      "duration": 2.919,
      "text": "wirklich so aus, als würde Fable 5.2"
    },
    {
      "start": 395.296,
      "duration": 3.023,
      "text": "sich die Design-Krone zurückholen, was"
    },
    {
      "start": 397.371,
      "duration": 2.971,
      "text": "bedeutet, dass es definitiv den ersten"
    },
    {
      "start": 399.394,
      "duration": 2.971,
      "text": "Platz als bestes Modell für Frontend-"
    },
    {
      "start": 401.365,
      "duration": 3.023,
      "text": "oder Webentwicklung zurückerobern wird"
    },
    {
      "start": 403.388,
      "duration": 4.342,
      "text": ". Denn dies ist ein Frontend, das Fable"
    },
    {
      "start": 406.791,
      "duration": 3.034,
      "text": "5.2 mit verschiedenen Paketen und"
    },
    {
      "start": 408.886,
      "duration": 3.657,
      "text": "Typografien generiert hat. Man sieht,"
    },
    {
      "start": 411.611,
      "duration": 2.904,
      "text": "wie klar und schön es diese"
    },
    {
      "start": 413.583,
      "duration": 3.652,
      "text": "Landingpage mit Scroll-Triggern und all"
    },
    {
      "start": 416.303,
      "duration": 3.516,
      "text": "diesen Elementen entwickeln konnte–"
    },
    {
      "start": 418.819,
      "duration": 3.448,
      "text": "alles generiert mit diesem einfachen"
    },
    {
      "start": 421.335,
      "duration": 3.312,
      "text": "Frontend, das es in einem einzigen"
    },
    {
      "start": 423.715,
      "duration": 3.244,
      "text": "Prompt vollständig programmieren"
    },
    {
      "start": 426.027,
      "duration": 4.145,
      "text": "konnte. Im Grunde könnte Anthropic"
    },
    {
      "start": 429.236,
      "duration": 2.948,
      "text": "aber zwei Monster gleichzeitig"
    },
    {
      "start": 431.249,
      "duration": 3.335,
      "text": "aushecken. Wir hatten bereits Opus 5.2"
    },
    {
      "start": 433.642,
      "duration": 3.144,
      "text": "erwähnt, das sich anscheinend darauf"
    },
    {
      "start": 435.844,
      "duration": 2.854,
      "text": "konzentriert, Programmierung und"
    },
    {
      "start": 437.756,
      "duration": 2.97,
      "text": "agentische Arbeit mit Opus auf ein"
    },
    {
      "start": 439.784,
      "duration": 3.086,
      "text": "neues Level zu heben; aber Fable 5.2"
    },
    {
      "start": 441.928,
      "duration": 3.087,
      "text": "könnte ein massiver Sprung für die"
    },
    {
      "start": 444.072,
      "duration": 2.565,
      "text": "Spieleentwicklung, visuelle"
    },
    {
      "start": 445.695,
      "duration": 2.159,
      "text": "Programmierung sowie"
    },
    {
      "start": 446.912,
      "duration": 3.445,
      "text": "Gen-Z-Programmierung sein. Und hier"
    },
    {
      "start": 449.417,
      "duration": 2.612,
      "text": "werden wir diese zwei neuen"
    },
    {
      "start": 451.088,
      "duration": 3.209,
      "text": "beeindruckenden Modelle von Anthropic"
    },
    {
      "start": 453.357,
      "duration": 3.209,
      "text": "bekommen, die die Grenzen noch weiter"
    },
    {
      "start": 455.625,
      "duration": 4.12,
      "text": "verschieben werden. Hier ist nun eine"
    },
    {
      "start": 458.796,
      "duration": 2.934,
      "text": "weitere Generierung von Fable 5.2, die"
    },
    {
      "start": 460.781,
      "duration": 4.843,
      "text": "einfach unglaublich ist, Leute. Dies"
    },
    {
      "start": 464.676,
      "duration": 2.945,
      "text": "ist ein vollwertiger Brawl-Stars-Klon,"
    },
    {
      "start": 466.672,
      "duration": 2.946,
      "text": "der nach nur einer Stunde vollständig"
    },
    {
      "start": 468.669,
      "duration": 4.157,
      "text": "entwickelt wurde. Und es hat all dies"
    },
    {
      "start": 471.88,
      "duration": 3.0,
      "text": "in reinem Code mit Three.js erstellt."
    },
    {
      "start": 474.08,
      "duration": 3.055,
      "text": "Schauen Sie sich nur die Qualität"
    },
    {
      "start": 476.195,
      "duration": 3.176,
      "text": "dieses Spiels an, das das neue Fable"
    },
    {
      "start": 478.432,
      "duration": 3.48,
      "text": "5.2 generiert hat. Dies sieht wirklich"
    },
    {
      "start": 480.951,
      "duration": 2.467,
      "text": "nach einem ziemlich ausgereiften Spiel"
    },
    {
      "start": 482.457,
      "duration": 2.081,
      "text": "aus, für das ein Entwickler"
    },
    {
      "start": 483.576,
      "duration": 2.506,
      "text": "wahrscheinlich mehrere Wochen gebraucht"
    },
    {
      "start": 485.121,
      "duration": 2.119,
      "text": "hätte, um es vollständig zu"
    },
    {
      "start": 486.279,
      "duration": 3.673,
      "text": "programmieren. Mit Animationen und"
    },
    {
      "start": 489.015,
      "duration": 3.198,
      "text": "verschiedenen Texturen, alles wurde"
    },
    {
      "start": 491.275,
      "duration": 3.324,
      "text": "vollständig von Fable 5.2 generiert."
    },
    {
      "start": 494.439,
      "duration": 2.844,
      "text": "Ich kann einfach nicht glauben, dass"
    },
    {
      "start": 496.334,
      "duration": 2.793,
      "text": "dieses Modell eine solche Qualität"
    },
    {
      "start": 498.179,
      "duration": 3.943,
      "text": "ausgeben konnte. Schauen wir nach vorne"
    },
    {
      "start": 501.122,
      "duration": 3.238,
      "text": ": Wir wissen, dass Gemini 4 angeblich"
    },
    {
      "start": 503.421,
      "duration": 3.299,
      "text": "in der Arena getestet wird, und bisher"
    },
    {
      "start": 505.78,
      "duration": 3.299,
      "text": "schlägt es sich in fast jedem Bereich"
    },
    {
      "start": 508.14,
      "duration": 4.372,
      "text": "beachtlich gut. Derselbe Prompt wurde"
    },
    {
      "start": 511.576,
      "duration": 3.222,
      "text": "mit GBC-6 Astra ausgeführt, und im"
    },
    {
      "start": 513.861,
      "duration": 3.285,
      "text": "direkten Vergleich wirkt die Version"
    },
    {
      "start": 516.21,
      "duration": 3.221,
      "text": "von Gemini 4 unglaublich stark; man"
    },
    {
      "start": 518.495,
      "duration": 3.285,
      "text": "kann wirklich sagen, dass es absolut"
    },
    {
      "start": 520.843,
      "duration": 2.714,
      "text": "mit den modernsten Modellen"
    },
    {
      "start": 522.62,
      "duration": 4.741,
      "text": "vergleichbar ist. Aber heute haben wir"
    },
    {
      "start": 526.431,
      "duration": 3.581,
      "text": "auch die Gemini 4-Benchmarks gesehen,"
    },
    {
      "start": 529.081,
      "duration": 3.162,
      "text": "die angeblichen Benchmarks, die"
    },
    {
      "start": 531.313,
      "duration": 3.696,
      "text": "überall auf X kursierten. Doch Leute,"
    },
    {
      "start": 534.074,
      "duration": 3.679,
      "text": "das ist eine Fälschung. Das ist ein"
    },
    {
      "start": 536.826,
      "duration": 3.384,
      "text": "komplettes Bild, das von einer KI"
    },
    {
      "start": 539.282,
      "duration": 4.065,
      "text": "generiert wurde. Tut mir leid, euch da"
    },
    {
      "start": 542.4,
      "duration": 3.056,
      "text": "enttäuschen zu müssen, aber wir haben"
    },
    {
      "start": 544.509,
      "duration": 2.951,
      "text": "viele neue, beeindruckende Vergleiche"
    },
    {
      "start": 546.512,
      "duration": 4.796,
      "text": "für euch. Dies ist ein Test, bei dem"
    },
    {
      "start": 550.389,
      "duration": 4.081,
      "text": "Gemini 4 gegen Fable 5 und GBZ 6 Astra"
    },
    {
      "start": 553.551,
      "duration": 4.234,
      "text": "antrat. Gemini 4 Pro konnte bei dieser"
    },
    {
      "start": 556.849,
      "duration": 3.286,
      "text": "spezifischen Generierung unglaublich"
    },
    {
      "start": 559.199,
      "duration": 3.35,
      "text": "detaillierte Strukturen erzeugen, und"
    },
    {
      "start": 561.613,
      "duration": 3.35,
      "text": "man sieht einfach, dass es ein extrem"
    },
    {
      "start": 564.026,
      "duration": 3.351,
      "text": "ausgefeiltes Endergebnis liefert, das"
    },
    {
      "start": 566.44,
      "duration": 3.287,
      "text": "vielleicht sogar besser aussieht als"
    },
    {
      "start": 568.79,
      "duration": 3.841,
      "text": "das der beiden anderen Modelle. Wenn"
    },
    {
      "start": 571.674,
      "duration": 2.628,
      "text": "euch dieses Video gefällt und ihr den"
    },
    {
      "start": 573.345,
      "duration": 2.543,
      "text": "Kanal unterstützen möchtet, könnt"
    },
    {
      "start": 574.93,
      "duration": 2.457,
      "text": "ihr eine Spende über die „Super"
    },
    {
      "start": 576.43,
      "duration": 2.5,
      "text": "Thanks“-Option unter dem Video in"
    },
    {
      "start": 577.973,
      "duration": 2.887,
      "text": "Betracht ziehen. Oder ihr könnt"
    },
    {
      "start": 579.917,
      "duration": 3.179,
      "text": "unserem privaten Discord beitreten, wo"
    },
    {
      "start": 582.153,
      "duration": 3.007,
      "text": "ihr monatlich kostenlosen Zugang zu"
    },
    {
      "start": 584.217,
      "duration": 2.95,
      "text": "mehreren Abonnements verschiedener"
    },
    {
      "start": 586.224,
      "duration": 2.893,
      "text": "KI-Tools sowie tägliche KI-News,"
    },
    {
      "start": 588.174,
      "duration": 2.892,
      "text": "exklusive Inhalte und vieles mehr"
    },
    {
      "start": 590.123,
      "duration": 3.566,
      "text": "erhaltet. Als Nächstes folgt eine"
    },
    {
      "start": 592.738,
      "duration": 2.883,
      "text": "ziemlich interessante Geschichte, laut"
    },
    {
      "start": 594.67,
      "duration": 3.418,
      "text": "dem Wall Street Journal. Googles Gemini"
    },
    {
      "start": 597.143,
      "duration": 2.538,
      "text": "hat angeblich während eines"
    },
    {
      "start": 598.736,
      "duration": 2.978,
      "text": "Cybersicherheitstests auf das offene"
    },
    {
      "start": 600.769,
      "duration": 2.923,
      "text": "Internet zugegriffen und ist in die"
    },
    {
      "start": 602.747,
      "duration": 2.923,
      "text": "Systeme von drei echten Unternehmen"
    },
    {
      "start": 604.725,
      "duration": 3.545,
      "text": "eingedrungen. Dies wird als der erste"
    },
    {
      "start": 607.331,
      "duration": 2.392,
      "text": "bekannte Ausbruch eines"
    },
    {
      "start": 608.783,
      "duration": 3.524,
      "text": "Google-KI-Modells beschrieben. Google"
    },
    {
      "start": 611.352,
      "duration": 2.426,
      "text": "ist mit diesem neuen Modell also"
    },
    {
      "start": 612.822,
      "duration": 3.02,
      "text": "definitiv auf einem guten Weg. Google"
    },
    {
      "start": 614.891,
      "duration": 2.912,
      "text": "erklärte jedoch, dass das Modell jeden"
    },
    {
      "start": 616.852,
      "duration": 2.668,
      "text": "Eindringversuch stoppte, sobald es"
    },
    {
      "start": 618.569,
      "duration": 2.569,
      "text": "erkannte, dass es auf ein echtes"
    },
    {
      "start": 620.187,
      "duration": 2.863,
      "text": "Unternehmen zugegriffen hatte, und gab"
    },
    {
      "start": 622.099,
      "duration": 2.717,
      "text": "an, dass der Vorfall keinen Schaden"
    },
    {
      "start": 623.865,
      "duration": 2.879,
      "text": "verursacht habe. Google teilte"
    },
    {
      "start": 625.784,
      "duration": 2.411,
      "text": "außerdem mit, dass der Vorfall zum"
    },
    {
      "start": 627.235,
      "duration": 2.532,
      "text": "damaligen Zeitpunkt keine umfassendere"
    },
    {
      "start": 628.807,
      "duration": 2.573,
      "text": "öffentliche Bekanntmachung erforderte."
    },
    {
      "start": 631.019,
      "duration": 2.647,
      "text": "Das ist eine wirklich coole und"
    },
    {
      "start": 632.719,
      "duration": 2.86,
      "text": "interessante Geschichte von Google,"
    },
    {
      "start": 634.632,
      "duration": 2.967,
      "text": "besonders da ihre Modelle bisher eher"
    },
    {
      "start": 636.652,
      "duration": 2.967,
      "text": "unter den Erwartungen geblieben sind."
    },
    {
      "start": 638.94,
      "duration": 3.076,
      "text": "Dies deutet wirklich darauf hin, dass"
    },
    {
      "start": 641.072,
      "duration": 3.02,
      "text": "ihre neuen Modelle in Bezug auf ihre"
    },
    {
      "start": 643.148,
      "duration": 3.189,
      "text": "Fähigkeiten in verschiedenen Bereichen"
    },
    {
      "start": 645.393,
      "duration": 3.954,
      "text": "ziemlich kompetent sind. Als Nächstes:"
    },
    {
      "start": 648.399,
      "duration": 2.717,
      "text": "XAI hat Grok 4.7 heute doch nicht"
    },
    {
      "start": 650.168,
      "duration": 3.029,
      "text": "veröffentlicht, da es so aussieht, als"
    },
    {
      "start": 652.249,
      "duration": 2.873,
      "text": "sei es auf nächste Woche verschoben"
    },
    {
      "start": 654.174,
      "duration": 3.668,
      "text": "worden. Aber sie haben Grok Voice"
    },
    {
      "start": 656.921,
      "duration": 4.306,
      "text": "Transcribe 2.0 angekündigt. Dies ist"
    },
    {
      "start": 660.286,
      "duration": 2.055,
      "text": "ein mehrsprachiges"
    },
    {
      "start": 661.399,
      "duration": 2.875,
      "text": "Spracherkennungsmodell, das laut"
    },
    {
      "start": 663.333,
      "duration": 3.051,
      "text": "Artificial Analysis derzeit bei der"
    },
    {
      "start": 665.442,
      "duration": 2.055,
      "text": "Genauigkeit von 32"
    },
    {
      "start": 666.555,
      "duration": 3.11,
      "text": "Streaming-Transkriptionsmodellen auf"
    },
    {
      "start": 668.723,
      "duration": 4.037,
      "text": "Platz eins liegt. Es unterstützt"
    },
    {
      "start": 671.814,
      "duration": 2.695,
      "text": "außerdem sowohl Batch-als auch"
    },
    {
      "start": 673.564,
      "duration": 3.132,
      "text": "Echtzeit-Streaming sowie Funktionen wie"
    },
    {
      "start": 675.75,
      "duration": 2.203,
      "text": "Sprecher-Diarisierung,"
    },
    {
      "start": 677.008,
      "duration": 2.968,
      "text": "Mehrkanal-Transkription, 18-Biasing,"
    },
    {
      "start": 679.03,
      "duration": 2.64,
      "text": "automatische Formatierung, das"
    },
    {
      "start": 680.725,
      "duration": 2.695,
      "text": "Entfernen von Füllwörtern und"
    },
    {
      "start": 682.474,
      "duration": 3.618,
      "text": "intelligente Spracherkennung. XCI"
    },
    {
      "start": 685.149,
      "duration": 3.064,
      "text": "entwickelt Grok also eindeutig über"
    },
    {
      "start": 687.27,
      "duration": 3.122,
      "text": "ein reines Sprachmodell hinaus weiter"
    },
    {
      "start": 689.449,
      "duration": 2.777,
      "text": "in Richtung Echtzeit-Sprach-und"
    },
    {
      "start": 691.284,
      "duration": 3.095,
      "text": "Audio-KI. Als Nächstes gibt es ein"
    },
    {
      "start": 693.421,
      "duration": 2.455,
      "text": "ziemlich großes Update für Claude"
    },
    {
      "start": 694.918,
      "duration": 2.497,
      "text": "Code, das gerade Unterstützung für"
    },
    {
      "start": 696.457,
      "duration": 4.159,
      "text": "agents.md hinzugefügt hat. Ab dieser"
    },
    {
      "start": 699.692,
      "duration": 3.787,
      "text": "neueren Version 2.1.277 prüft Claude"
    },
    {
      "start": 702.554,
      "duration": 3.562,
      "text": "Code automatisch auf agents.md und"
    },
    {
      "start": 705.191,
      "duration": 3.561,
      "text": "verwendet diese Datei, falls keine"
    },
    {
      "start": 707.828,
      "duration": 3.561,
      "text": "Claude.md im Ordner gefunden wird;"
    },
    {
      "start": 710.464,
      "duration": 3.863,
      "text": "dieses Verhalten lässt sich über den"
    },
    {
      "start": 713.402,
      "duration": 5.149,
      "text": "Befehl/config steuern. Das wirklich"
    },
    {
      "start": 717.605,
      "duration": 3.012,
      "text": "Interessante daran ist, dass dies auf"
    },
    {
      "start": 719.672,
      "duration": 2.957,
      "text": "Claude Code Mods und einem kommenden"
    },
    {
      "start": 721.684,
      "duration": 3.066,
      "text": "System basiert, mit dem Entwickler die"
    },
    {
      "start": 723.804,
      "duration": 3.121,
      "text": "Claude-Code-Umgebung anpassen und sogar"
    },
    {
      "start": 725.98,
      "duration": 2.685,
      "text": "ihre eigenen Produktanweisungen"
    },
    {
      "start": 727.72,
      "duration": 3.772,
      "text": "erstellen können. Claude Code wird"
    },
    {
      "start": 730.544,
      "duration": 2.718,
      "text": "durch dieses neue Feature also in"
    },
    {
      "start": 732.314,
      "duration": 2.873,
      "text": "Zukunft deutlich flexibler anpassbar"
    },
    {
      "start": 734.239,
      "duration": 4.667,
      "text": "sein. Kommen wir zu KI-Leaks: Es wurden"
    },
    {
      "start": 737.966,
      "duration": 2.669,
      "text": "Gemini Worlds gezeigt–eine"
    },
    {
      "start": 739.695,
      "duration": 3.087,
      "text": "beeindruckende frühe Demo, die ein"
    },
    {
      "start": 741.841,
      "duration": 3.206,
      "text": "unglaublich detailliertes, immersives"
    },
    {
      "start": 744.107,
      "duration": 3.146,
      "text": "Umgebungssystem präsentiert, in dem"
    },
    {
      "start": 746.313,
      "duration": 3.266,
      "text": "man verschiedene Welten erkunden kann."
    },
    {
      "start": 750.34,
      "duration": 3.14,
      "text": "Google verfolgt hier einen spannenden"
    },
    {
      "start": 752.538,
      "duration": 3.14,
      "text": "Ansatz, denn ich bin überzeugt, dass"
    },
    {
      "start": 754.736,
      "duration": 2.909,
      "text": "dies eine großartige interaktive"
    },
    {
      "start": 756.703,
      "duration": 2.504,
      "text": "Methode zum Lernen und zur"
    },
    {
      "start": 758.265,
      "duration": 2.562,
      "text": "Präsentation verschiedener"
    },
    {
      "start": 759.885,
      "duration": 4.622,
      "text": "Visualisierungen ist. Die Idee ist,"
    },
    {
      "start": 763.571,
      "duration": 3.103,
      "text": "dass man sich durch KI-generierte"
    },
    {
      "start": 765.738,
      "duration": 2.658,
      "text": "Welten bewegen und sie aus"
    },
    {
      "start": 767.459,
      "duration": 3.231,
      "text": "verschiedenen Perspektiven erkunden"
    },
    {
      "start": 769.754,
      "duration": 3.231,
      "text": "kann–egal ob mikroskopisch klein,"
    },
    {
      "start": 772.049,
      "duration": 3.486,
      "text": "völlig imaginär oder tief im Weltraum"
    },
    {
      "start": 774.535,
      "duration": 4.735,
      "text": ". Google investiert bereits stark in"
    },
    {
      "start": 778.329,
      "duration": 3.271,
      "text": "diese Richtung mit Genie 3 und Project"
    },
    {
      "start": 780.659,
      "duration": 3.151,
      "text": "Genie, das interaktive Umgebungen in"
    },
    {
      "start": 782.87,
      "duration": 2.911,
      "text": "Echtzeit während der Navigation"
    },
    {
      "start": 784.841,
      "duration": 3.085,
      "text": "generiert. Sollte diese"
    },
    {
      "start": 786.982,
      "duration": 2.999,
      "text": "Gemini-Worlds-Demo authentisch sein,"
    },
    {
      "start": 789.037,
      "duration": 2.944,
      "text": "sieht es so aus, als könnte Google"
    },
    {
      "start": 791.037,
      "duration": 3.166,
      "text": "dieses Konzept noch weiter vorantreiben"
    },
    {
      "start": 793.203,
      "duration": 3.395,
      "text": ". Jede hier gezeigte Umgebung sieht"
    },
    {
      "start": 795.647,
      "duration": 2.788,
      "text": "unglaublich detailliert aus, und ich"
    },
    {
      "start": 797.484,
      "duration": 2.589,
      "text": "bin sehr gespannt, wann sie dies"
    },
    {
      "start": 799.123,
      "duration": 2.837,
      "text": "tatsächlich veröffentlichen werden."
    },
    {
      "start": 802.66,
      "duration": 3.071,
      "text": "Zuletzt gibt es ein Update von Figure:"
    },
    {
      "start": 804.786,
      "duration": 2.962,
      "text": "Sie haben nun Helix 2.5 vollständig"
    },
    {
      "start": 806.803,
      "duration": 2.799,
      "text": "eingeführt, und das ist wirklich"
    },
    {
      "start": 808.656,
      "duration": 5.213,
      "text": "beeindruckend. Ich möchte diesen"
    },
    {
      "start": 812.949,
      "duration": 4.142,
      "text": "humanoiden Roboter unbedingt kaufen und"
    },
    {
      "start": 816.172,
      "duration": 3.98,
      "text": "bei mir zu Hause haben, da er die Art"
    },
    {
      "start": 819.233,
      "duration": 3.739,
      "text": "und Weise, wie Roboter unser Leben"
    },
    {
      "start": 822.052,
      "duration": 4.142,
      "text": "unterstützen–etwa beim Wäschefalten"
    },
    {
      "start": 825.275,
      "duration": 4.061,
      "text": "oder in der Küche–, revolutionieren"
    },
    {
      "start": 828.417,
      "duration": 4.761,
      "text": "wird. Es gibt nun Aufnahmen von vier"
    },
    {
      "start": 832.253,
      "duration": 3.463,
      "text": "Stunden, in denen Helix 2.5 in 30"
    },
    {
      "start": 834.791,
      "duration": 3.165,
      "text": "verschiedenen Haushalten ohne"
    },
    {
      "start": 837.031,
      "duration": 4.093,
      "text": "zusätzliches Training arbeitet. Dabei"
    },
    {
      "start": 840.193,
      "duration": 3.558,
      "text": "wurden zufällig ausgewählte Roboter"
    },
    {
      "start": 842.82,
      "duration": 3.419,
      "text": "aus dem Standby-Modus in unbekannte"
    },
    {
      "start": 845.308,
      "duration": 3.35,
      "text": "Umgebungen geschickt, in denen sie"
    },
    {
      "start": 847.727,
      "duration": 3.754,
      "text": "zuvor noch nie waren. Und hier ist es"
    },
    {
      "start": 850.543,
      "duration": 3.249,
      "text": "in der Lage, tatsächlich in völlig"
    },
    {
      "start": 852.855,
      "duration": 3.374,
      "text": "unterschiedlichen realen Umgebungen zu"
    },
    {
      "start": 855.291,
      "duration": 3.312,
      "text": "arbeiten, ohne für jedes Zuhause neu"
    },
    {
      "start": 857.665,
      "duration": 3.747,
      "text": "trainiert werden zu müssen. Dies ist"
    },
    {
      "start": 860.456,
      "duration": 2.589,
      "text": "ein weiterer großer Einblick in die"
    },
    {
      "start": 862.089,
      "duration": 1.927,
      "text": "Richtung, in die sich"
    },
    {
      "start": 863.06,
      "duration": 2.281,
      "text": "Allzweck-Humanoide schon bald"
    },
    {
      "start": 864.385,
      "duration": 3.354,
      "text": "entwickeln werden. Aber Leute, das war"
    },
    {
      "start": 866.774,
      "duration": 2.325,
      "text": "es auch schon mit dem heutigen Video."
    },
    {
      "start": 868.199,
      "duration": 2.029,
      "text": "Ich werde alle Links, die ich im"
    },
    {
      "start": 869.26,
      "duration": 2.254,
      "text": "heutigen Video verwendet habe, unten in"
    },
    {
      "start": 870.547,
      "duration": 2.434,
      "text": "die Beschreibung setzen. Schaut euch"
    },
    {
      "start": 872.033,
      "duration": 2.944,
      "text": "unbedingt den World of AI Insider Club"
    },
    {
      "start": 874.028,
      "duration": 2.792,
      "text": "an, das ist unsere Schul-Community."
    },
    {
      "start": 876.159,
      "duration": 2.758,
      "text": "Werft einen Blick auf die World of AI"
    },
    {
      "start": 877.964,
      "duration": 2.853,
      "text": "Bob Kading Plattform und das Benchmark,"
    },
    {
      "start": 879.865,
      "duration": 2.568,
      "text": "um bessere Einblicke zu erhalten,"
    },
    {
      "start": 881.48,
      "duration": 2.759,
      "text": "welches Modell ihr verwenden solltet."
    },
    {
      "start": 883.52,
      "duration": 2.36,
      "text": "Schaut euch den zweiten Kanal an."
    },
    {
      "start": 885.459,
      "duration": 2.582,
      "text": "Meldet euch unbedingt für unseren"
    },
    {
      "start": 887.088,
      "duration": 3.563,
      "text": "Newsletter an. Kommt zu uns auf Discord"
    },
    {
      "start": 889.651,
      "duration": 2.658,
      "text": ". Folgt mir auf Twitter. Und zu guter"
    },
    {
      "start": 891.342,
      "duration": 2.227,
      "text": "Letzt: Abonniert den Kanal. Aktiviert"
    },
    {
      "start": 892.594,
      "duration": 1.95,
      "text": "die Benachrichtigungsglocke. Gebt"
    },
    {
      "start": 893.578,
      "duration": 2.335,
      "text": "diesem Video ein Like. Und bitte seht"
    },
    {
      "start": 894.947,
      "duration": 2.32,
      "text": "euch unsere früheren Videos an, damit"
    },
    {
      "start": 896.301,
      "duration": 2.355,
      "text": "ihr bei den neuesten KI-Nachrichten auf"
    },
    {
      "start": 897.69,
      "duration": 2.292,
      "text": "dem Laufenden bleibt. Aber mit diesem"
    },
    {
      "start": 899.013,
      "duration": 1.832,
      "text": "Gedanken, Leute, habt einen"
    },
    {
      "start": 899.876,
      "duration": 2.032,
      "text": "großartigen Tag. Verbreitet"
    },
    {
      "start": 900.948,
      "duration": 2.46,
      "text": "Positivität. Und wir sehen uns schon"
    },
    {
      "start": 902.444,
      "duration": 2.29,
      "text": "bald wieder. Macht's gut, Leute."
    }
  ]
