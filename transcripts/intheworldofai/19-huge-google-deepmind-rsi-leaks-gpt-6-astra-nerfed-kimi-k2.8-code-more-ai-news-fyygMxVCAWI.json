    {
      "start": 427.976,
      "duration": 2.893,
      "text": "bei einer neuen Version die Nummer"
    },
    {
      "start": 429.924,
      "duration": 4.41,
      "text": "senkt. Wenn dir dieses Video gefällt"
    },
    {
      "start": 433.38,
      "duration": 2.375,
