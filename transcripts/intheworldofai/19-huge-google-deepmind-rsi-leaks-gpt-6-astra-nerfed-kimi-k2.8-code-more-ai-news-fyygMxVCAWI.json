      "start": 548.399,
      "duration": 2.545,
      "text": "zusammen mit einigen kleineren"
    },
    {
      "start": 549.996,
      "duration": 2.958,
      "text": "Verbesserungen, die Astra konsistenter"
    },
    {
      "start": 552.005,
      "duration": 2.495,
      "text": "machen und die Selbstprüfung"
    },
    {
      "start": 553.551,
      "duration": 3.799,
