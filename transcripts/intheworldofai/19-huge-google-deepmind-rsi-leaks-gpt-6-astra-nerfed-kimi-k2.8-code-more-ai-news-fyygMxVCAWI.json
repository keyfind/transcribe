    },
    {
      "start": 388.747,
      "duration": 2.298,
      "text": "besten Open-Source-Modelle, die es"
    },
    {
      "start": 390.083,
      "duration": 3.202,
      "text": "derzeit gibt. Aber eines der größten"
    },
    {
      "start": 392.337,
      "duration": 2.869,
      "text": "Probleme dieses Modells ist, dass es"
    },
    {
      "start": 394.258,
      "duration": 2.609,
      "text": "bei jeder Anfrage viel zu lange"
    },
    {
      "start": 395.919,
      "duration": 3.602,
      "text": "nachdenkt. Es neigt dazu, bei einfachen"
    },
    {
      "start": 398.566,
      "duration": 2.556,
      "text": "Aufgaben zu lange zu grübeln, was"
    },
    {
      "start": 400.168,
      "duration": 2.601,
