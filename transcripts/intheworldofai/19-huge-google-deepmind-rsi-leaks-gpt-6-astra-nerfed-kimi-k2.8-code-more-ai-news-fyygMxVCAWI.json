    },
    {
      "start": 471.874,
      "duration": 2.626,
      "text": "Reasoning-Einstellungen. Die"
    },
    {
      "start": 473.56,
      "duration": 2.694,
      "text": "Startversion wirkte merklich"
    },
    {
      "start": 475.315,
      "duration": 2.935,
      "text": "fotorealistischer, schärfer und"
    },
