      "start": 479.488,
      "duration": 3.573,
      "text": "komplexen 3 D-Szenen. Die neueren"
    },
    {
      "start": 482.119,
      "duration": 3.161,
      "text": "Generationen wirken hingegen flacher,"
    },
    {
      "start": 484.339,
      "duration": 3.044,
      "text": "synthetischer und insgesamt weniger"
    },
    {
      "start": 486.441,
      "duration": 4.277,
      "text": "beeindruckend. Dies führte sofort zu"
    },
    {
      "start": 489.772,
