    },
    {
      "start": 404.584,
      "duration": 2.976,
      "text": "2.8 also eine ähnliche Leistung bei"
    },
    {
      "start": 406.615,
      "duration": 3.086,
      "text": "deutlich schnellerem Reasoning liefern"
    },
    {
      "start": 408.755,
      "duration": 2.592,
      "text": "kann, könnte es ein wirklich"
    },
    {
      "start": 410.402,
      "duration": 3.779,
      "text": "nützliches Modell sein. Nutzer mit"
    },
    {
      "start": 413.255,
      "duration": 3.821,
