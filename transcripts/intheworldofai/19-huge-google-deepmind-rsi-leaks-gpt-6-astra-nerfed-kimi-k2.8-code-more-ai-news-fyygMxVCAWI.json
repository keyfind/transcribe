    },
    {
      "start": 438.1,
      "duration": 3.415,
      "text": "Erwägung ziehen. Oder du trittst"
    },
    {
      "start": 440.579,
      "duration": 3.23,
      "text": "unserem privaten Discord bei, wo du"
    },
    {
      "start": 442.873,
      "duration": 3.103,
      "text": "monatlich kostenlosen Zugriff auf"
    },
    {
      "start": 445.04,
      "duration": 3.357,
      "text": "verschiedene KI-Tools sowie tägliche"
    },
    {
      "start": 447.461,
      "duration": 3.358,
      "text": "KI-News, exklusive Inhalte und vieles"
