    {
      "start": 785.186,
      "duration": 4.276,
      "text": "erzeugte. Es ist wirklich eine Frage"
    },
    {
      "start": 788.521,
      "duration": 3.076,
      "text": "der persönlichen Vorliebe, welches"
    },
    {
      "start": 790.656,
      "duration": 2.957,
      "text": "Modell bei der Generierung dieses"
    },
    {
      "start": 792.673,
      "duration": 3.135,
      "text": "Bildes bessere Arbeit geleistet hat,"
    },
    {
      "start": 794.867,
