      "start": 734.935,
      "duration": 3.24,
      "text": "neues Nano-Banana-Bildmodell namens"
    },
    {
      "start": 737.239,
      "duration": 3.24,
      "text": "Spicy Mayo–lustiger Name–ist in"
    },
    {
      "start": 739.543,
      "duration": 3.368,
      "text": "Eleonora aufgetaucht, und es ist noch"
    },
    {
      "start": 741.975,
      "duration": 3.835,
      "text": "unklar, was genau das ist. Es ist"
    },
    {
      "start": 744.869,
      "duration": 3.163,
      "text": "vielleicht nicht das Nano Banana 2.5,"
    },
    {
      "start": 747.09,
      "duration": 2.579,
      "text": "könnte aber ein Flash-oder"
    },
    {
      "start": 748.727,
      "duration": 3.73,
      "text": "Light-Update sein. Wir haben bereits"
    },
    {
      "start": 751.51,
      "duration": 3.014,
      "text": "das GPT-Bildmodell 2.5, das gerade von"
    },
    {
      "start": 753.577,
      "duration": 3.167,
      "text": "OpenAI veröffentlicht wurde. Es ergibt"
    },
    {
      "start": 755.795,
      "duration": 2.849,
      "text": "also Sinn, dass Google versucht, mit"
    },
    {
      "start": 757.695,
      "duration": 2.9,
      "text": "dieser neuen Variante Marktanteile zu"
    },
    {
      "start": 759.646,
      "duration": 2.798,
      "text": "gewinnen, und die Veröffentlichung"
    },
    {
      "start": 761.495,
      "duration": 3.536,
      "text": "könnte sehr bald erfolgen. Es gibt"
    },
    {
      "start": 764.082,
      "duration": 2.866,
      "text": "tatsächlich einen Vergleich zwischen"
    },
    {
      "start": 765.998,
      "duration": 2.513,
      "text": "dem GPT-Bildmodell 2.5 und dem"
    },
    {
      "start": 767.561,
